{
  "name": "@digilac/simap-mcp",
  "version": "1.7.1",
  "mcpName": "io.github.Digilac/simap-mcp",
  "description": "MCP server for simap.ch - Swiss public procurement platform",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "simap-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "inspect": "fastmcp dev inspector dist/server.js:createServer",
    "tools": "fastmcp list --file dist/server.js:createServer --input-schema",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "update:check": "npx npm-check-updates --target semver",
    "update": "npx npm-check-updates --target semver -u",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-server-json.mjs && npm install --package-lock-only",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digilac/simap-mcp.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "simap",
    "procurement",
    "switzerland",
    "tenders",
    "claude"
  ],
  "author": "Digilac",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/Digilac/simap-mcp/issues"
  },
  "homepage": "https://github.com/Digilac/simap-mcp#readme",
  "dependencies": {
    "@prefecthq/fastmcp-ts": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
